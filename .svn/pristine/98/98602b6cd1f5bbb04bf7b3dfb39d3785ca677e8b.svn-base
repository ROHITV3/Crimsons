{
  "name": "cordova-plugin-file-md5",
  "version": "0.3.3",
  "description": "Cordova MD5 checksum plugin for Android and iOS. The plugin reads large files in chunks and build the md5sum incrementally. It can process much larger files then read the complete content in memory and process it in place.",
