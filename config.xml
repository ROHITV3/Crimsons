<?xml version='1.0' encoding='utf-8'?>
<widget android-versionCode="010000" id="com.cl.acps" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DevelopTT</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="http://cordova.io">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="assets/acps-final-logo.png" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <plugin name="cordova-plugin-compat" spec="^1.2.0" />
    <plugin name="cordova-plugin-android-permissions" spec="^1.0.0" />
    <plugin name="cordova-plugin-network-information" spec="~1.3.3-dev" />
    <plugin name="cordova-plugin-file-downloader" spec="^0.4.0" />
    <plugin name="cordova-plugin-file-transfer" spec="~1.6.3-dev" />
    <plugin name="com.testfairy.cordova-plugin" spec="^2.22.1" />
    <engine name="android" spec="^6.3.0" />
</widget>
